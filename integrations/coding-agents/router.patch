+    expect(new Headers(init?.headers).get("x-memory-router-agent")).toBe("codex");
+    expect(init?.redirect).toBe("error");
+  }
+});
+
+it.each([401, 403])("stops git-log synchronization after denied freshness probe %s", async (status) => {
