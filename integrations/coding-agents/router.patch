+++ b/src/core/logging-privacy.test.ts
@@ -0,0 +1,391 @@
+import { ChildProcess, type spawn } from "node:child_process";
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { basename, join } from "node:path";
+import { PassThrough } from "node:stream";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { npmViewVersion } from "./auto-update";
+import { resolveConfig } from "./config";
+import { diag, parseHookEvent } from "./diag";
+import * as git from "./git";
+import { HindsightClient, ReflectError } from "./hindsight";
+import { buildHookOutput } from "./hook";
+import * as hookLifecycle from "./hook";
+import { buildKnowledgeTools } from "./knowledge-tools";
+import { log, setLogLevel } from "./log";
+import { buildRetain } from "./retain-hook";
+import { MAX_RUNTIME_SESSIONS, RuntimeCore } from "./runtime";
+import * as seed from "./seed";
+import * as sessionStart from "./session-start";
+import * as companionSkill from "./skill-sync";
+import { writeSessionCache } from "./session-cache";
+
+const PROMPT = "PROMPT_CANARY_private_question";
+const ANSWER = "ANSWER_CANARY_private_memory";
+const FAILURE = "FAILURE_CANARY_private_response";
+const IDENTITY = "IDENTITY_CANARY_private_path";
+let root: string;
+let diagnostic: string;
+let ordinary: string;
+
+function contents(path: string): string {
+  return existsSync(path) ? readFileSync(path, "utf8") : "";
+}
+
+function records(): Record<string, unknown>[] {
+  return contents(diagnostic).trim().split("\n").filter(Boolean)
+    .map((line) => JSON.parse(line) as Record<string, unknown>);
+}
+
+function client(): HindsightClient {
+  const instance = new HindsightClient({ routerHarness: "codex", apiUrl: "https://router.test", bank: "A" });
+  vi.spyOn(instance, "reflect").mockResolvedValue(ANSWER);
+  vi.spyOn(instance, "listPages").mockResolvedValue({ items: [{ id: IDENTITY, name: ANSWER }] });
+  vi.spyOn(instance, "searchKnowledgePages").mockResolvedValue([]);
+  vi.spyOn(instance, "recallObservations").mockResolvedValue([]);
+  return instance;
+}
+
+beforeEach(() => {
+  root = mkdtempSync(join(tmpdir(), "logging-privacy-"));
+  diagnostic = join(root, "diag.jsonl");
+  ordinary = join(root, "plugin.log");
+  vi.stubEnv("TMPDIR", root);
+  vi.stubEnv("HINDSIGHT_DIAG_FILE", diagnostic);
+  vi.stubEnv("HINDSIGHT_LOG_FILE", ordinary);
+  vi.stubEnv("HINDSIGHT_USAGE_FILE", join(root, "usage.jsonl"));
+  vi.stubEnv("HINDSIGHT_LOG_LEVEL", "");
+  const managed = join(root, "managed.json");
+  writeFileSync(managed, JSON.stringify({ routerUrl: "https://router.test", principals: {
+    codex: { tokenEnv: "LOGGING_TEST_TOKEN", writeBank: "A", mapPathToBank: { [root]: "A" } },
+  } }));
+  vi.stubEnv("HINDSIGHT_ROUTER_CONFIG", managed);
+  vi.stubEnv("LOGGING_TEST_TOKEN", `mr_codex_${"b".repeat(64)}`);
+});
+
+afterEach(() => {
+  try {
+    for (const file of [diagnostic, ordinary]) {
+      for (const canary of [PROMPT, ANSWER, FAILURE, IDENTITY]) expect(contents(file)).not.toContain(canary);
+    }
+  } finally {
+    setLogLevel("info");
+    vi.unstubAllEnvs();
+    vi.restoreAllMocks();
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+describe.each(["info", "debug"] as const)("metadata-only logs at %s", (level) => {
+  beforeEach(() => setLogLevel(level));
+
+  it("classifies the updater hard deadline without retaining registry output or late errors", async () => {
+    vi.useFakeTimers();
+    const child = new ChildProcess();
+    const output = new PassThrough();
+    child.stdout = output;
+    const kill = vi.spyOn(child, "kill").mockReturnValue(true);
+    const spawnImpl = vi.fn<typeof spawn>().mockReturnValue(child) as unknown as typeof spawn;
+    try {
+      let settled = false;
+      const result = npmViewVersion(IDENTITY, spawnImpl).then((version) => { settled = true; return version; });
+      output.write(`${PROMPT} ${ANSWER}`);
+      await vi.advanceTimersByTimeAsync(5_999);
+      expect(settled).toBe(false);
+      expect(kill).not.toHaveBeenCalled();
+      await vi.advanceTimersByTimeAsync(1);
+      await expect(result).resolves.toBe("");
+      expect(kill).toHaveBeenCalledExactlyOnceWith("SIGKILL");
+      child.emit("error", new Error(FAILURE));
+      child.emit("close", 1);
+      expect(contents(ordinary).trim().split("\n")).toHaveLength(1);
+      expect(contents(ordinary)).toContain('version check failed {"errorClass":"timeout"}');
+      expect(vi.getTimerCount()).toBe(0);
+    } finally {
+      output.destroy();
+      vi.useRealTimers();
+    }
+  });
+
+  it.each([
+    { outcome: "spawn timeout", delay: 5_000, code: null, signal: "SIGTERM", killed: true, errorClass: "timeout" },
+    { outcome: "nonzero exit", delay: 1_000, code: 1, signal: null, killed: false, errorClass: "operation_failed" },
+    { outcome: "nonzero exit after a handled signal", delay: 5_000, code: 1, signal: null, killed: true, errorClass: "operation_failed" },
+    { outcome: "early external SIGTERM", delay: 1_000, code: null, signal: "SIGTERM", killed: false, errorClass: "operation_failed" },
+    { outcome: "external SIGTERM at timeout", delay: 5_000, code: null, signal: "SIGTERM", killed: false, errorClass: "operation_failed" },
+    { outcome: "another termination signal", delay: 1_000, code: null, signal: "SIGKILL", killed: true, errorClass: "operation_failed" },
+  ])("classifies updater $outcome without retaining content", async ({ delay, code, signal, killed, errorClass }) => {
+    vi.useFakeTimers();
+    const child = new ChildProcess();
+    const output = new PassThrough();
+    child.stdout = output;
+    const kill = vi.spyOn(child, "kill").mockReturnValue(true);
+    const spawnImpl = vi.fn<typeof spawn>().mockReturnValue(child) as unknown as typeof spawn;
+    try {
+      const result = npmViewVersion(IDENTITY, spawnImpl);
+      output.write(`${PROMPT} ${ANSWER}`);
+      // Elapsed time alone does not identify a timeout: npm can fail or receive an
+      // external signal at the same time. Node sets killed only after child.kill succeeds.
+      await vi.advanceTimersByTimeAsync(delay);
+      Object.defineProperty(child, "killed", { value: killed });
+      child.emit("close", code, signal);
+      await expect(result).resolves.toBe("");
+      child.emit("error", new Error(FAILURE));
+      child.emit("close", 1, null);
+      await vi.advanceTimersByTimeAsync(6_000 - delay);
+      expect(kill).not.toHaveBeenCalled();
+      expect(vi.getTimerCount()).toBe(0);
+      expect(contents(ordinary).trim().split("\n")).toHaveLength(1);
+      expect(contents(ordinary)).toContain(`version check failed {"errorClass":"${errorClass}"}`);
+      expect(contents(diagnostic)).toBe("");
+    } finally {
+      output.destroy();
+      vi.useRealTimers();
+    }
+  });
+
+  it("keeps successful reflection content in the injection and out of both log files", async () => {
+    const output = await buildHookOutput({ harness: "codex", prompt: PROMPT,
+      cfg: resolveConfig(), client: client(), cacheFile: join(root, "session.json") });
+    expect(output.context).toContain(ANSWER);
+    expect(records()).toContainEqual(expect.objectContaining({ event: "reflect_ok", chars: ANSWER.length }));
+    expect(records().find((entry) => entry.event === "reflect_ok")).not.toHaveProperty("query");
+    if (level === "debug") expect(contents(ordinary)).toContain("diag:reflect_ok");
+  });
+
+  it("keeps capacity and disposal diagnostics private while retaining the numeric session limit", async () => {
+    const runtime = new RuntimeCore(client(), "A", resolveConfig({ logLevel: level }), "codex", root);
+    for (let i = 0; i < MAX_RUNTIME_SESSIONS; i++) await runtime.onPrompt(`${IDENTITY}-${i}`, "");
+    await runtime.onPrompt(IDENTITY, PROMPT);
+    expect(runtime.hasSession(IDENTITY)).toBe(false);
+    expect(runtime.getInjection(IDENTITY)).toBeUndefined();
+    expect(records()).toContainEqual(expect.objectContaining({
+      event: "session_capacity_reached", limit: MAX_RUNTIME_SESSIONS,
+    }));
+    if (level === "debug") expect(contents(ordinary)).toContain(`"limit":${MAX_RUNTIME_SESSIONS}`);
+    runtime.disposeSession(`${IDENTITY}-0`);
+    await runtime.onPrompt(IDENTITY, PROMPT);
+    expect(runtime.hasSession(IDENTITY)).toBe(true);
