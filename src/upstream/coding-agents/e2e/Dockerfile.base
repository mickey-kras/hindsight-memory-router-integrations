# Shared base for every harness image: toolchain, entrypoint, PATH. Each harness image adds ONLY
# its own CLI on top, so one vendor's broken installer can no longer fail the whole matrix — and a
# harness rebuild stays small because this layer is cached across all of them.
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
    && rm -rf /var/lib/apt/lists/*

# Vendor install scripts drop binaries here.
ENV PATH="/root/.local/bin:${PATH}"

COPY run-harness.sh /usr/local/bin/hindsight-e2e-runner
RUN chmod 755 /usr/local/bin/hindsight-e2e-runner

ENTRYPOINT ["/usr/local/bin/hindsight-e2e-runner"]
