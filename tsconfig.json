{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/plugin.ts", "src/shared/hosted-client.ts", "src/shared/fs-native-extensions.d.ts"],
  "exclude": ["src/upstream/**/__tests__/**", "src/upstream/**/*.test.ts", "node_modules", "dist"]
}
