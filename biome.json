{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!coverage", "!dist", "!packages", "!src/upstream", "!**/*.md", "!**/*.yml", "!**/*.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImplicitAnyLet": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [".github/scripts/dependabot-preparation.test.cjs", ".github/trusted-ci/workflows.test.cjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": [".github/rulesets/protect-release-branches.json"],
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    }
  ]
}
