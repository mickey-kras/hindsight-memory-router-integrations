{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": ["**", "!coverage", "!dist", "!packages", "!src/upstream"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImplicitAnyLet": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
