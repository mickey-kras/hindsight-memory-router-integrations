{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@modelcontextprotocol/sdk/client/index.js": [
        "./src/mcp/node_modules/@modelcontextprotocol/sdk/dist/esm/client/index.d.ts"
      ],
      "@modelcontextprotocol/sdk/types.js": ["./src/mcp/node_modules/@modelcontextprotocol/sdk/dist/esm/types.d.ts"],
      "@modelcontextprotocol/sdk/inMemory.js": [
        "./src/mcp/node_modules/@modelcontextprotocol/sdk/dist/esm/inMemory.d.ts"
      ]
    }
  },
  "include": [
    "src/plugin.ts",
    "src/shared/**/*.ts",
    "src/coding-agents/**/*.ts",
    "src/mcp/**/*.ts",
    "src/upstream/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/upstream/coding-agents/**", "tests/coding-agents-upstream.test.ts"]
}
