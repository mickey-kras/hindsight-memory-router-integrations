{
  "name": "@mickey-kras/hindsight-memory-router-openclaw",
  "version": "0.14.7",
  "description": "Per-agent OpenClaw memory routing plugin for hindsight-memory-router (forks vectorize-io/hindsight OpenClaw integration v1.0.0)",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "keywords": [
    "openclaw",
    "memory",
    "hindsight",
    "memory-router",
    "per-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickey-kras/hindsight-memory-router-integrations.git"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "UPSTREAM_VERSION",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "aislop:ci": "aislop ci",
    "aislop:ci:human": "aislop ci --human",
    "aislop:ci:sarif": "aislop ci --sarif",
    "build": "npm run clean && tsc",
    "lint": "biome lint . --max-diagnostics=none",
    "format:check": "biome format . --max-diagnostics=none",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.integration.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "build:coding-agents": "npm run build --prefix src/upstream/coding-agents",
    "test:coding-agents": "vitest run tests/coding-agents-upstream.test.ts",
    "audit:coding-agents": "npm audit --prefix src/upstream/coding-agents --audit-level=moderate",
    "upstream:accept": "node scripts/regen-coding-local-changes.mjs && node scripts/regen-openclaw-overlay.mjs && node scripts/verify-coding-upstream.mjs && node scripts/verify-openclaw-overlay.mjs"
  },
  "dependencies": {
    "@vectorize-io/hindsight-agent-sdk": "0.1.1",
    "@vectorize-io/hindsight-client": "1.1.0",
    "fs-native-extensions": "^1.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "aislop": "0.18.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./hosted": {
      "types": "./dist/shared/hosted-client.d.ts",
      "import": "./dist/shared/hosted-client.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "overrides": {
    "@vectorize-io/hindsight-agent-sdk": {
      "@vectorize-io/hindsight-client": "1.1.0"
    },
    "ip-address": ">=10.7.4 <11.0.0"
  }
}
