{
  "name": "@mickey-kras/hindsight-memory-router-openclaw",
  "version": "0.11.1-router.4",
  "description": "Per-agent OpenClaw memory routing plugin for hindsight-memory-router (forks vectorize-io/hindsight OpenClaw integration v0.11.1)",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "keywords": [
    "openclaw",
    "memory",
    "hindsight",
    "memory-router",
    "per-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickey-kras/hindsight-memory-router-integrations.git"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "UPSTREAM_VERSION",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "aislop:ci": "aislop ci",
    "aislop:ci:human": "aislop ci --human",
    "aislop:ci:sarif": "aislop ci --sarif",
    "build": "npm run clean && tsc",
    "lint": "biome lint . --max-diagnostics=none",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "build:coding-agents": "npm run build --prefix src/upstream/coding-agents",
    "test:coding-agents": "vitest run tests/coding-agents-upstream.test.ts",
    "audit:coding-agents": "npm audit --prefix src/upstream/coding-agents --audit-level=moderate"
  },
  "dependencies": {
    "@vectorize-io/hindsight-agent-sdk": "0.1.1",
    "@vectorize-io/hindsight-client": "0.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "aislop": "^0.16.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
